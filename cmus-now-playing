#!/usr/bin/env bash
#
# cmus-now-playing — print "now playing" status from cmus (cmus-remote)
#
# Designed for status bars and scripts (tmux, waybar, polybar, i3blocks,
# conky, shell prompts). Outputs a single formatted line to stdout.
#
# Usage:
#   cmus-now-playing [OPTIONS]
#
# Options:
#   -f, --format FORMAT   Output format string (default: "{artist} - {title}")
#                         Placeholders:
#                           {state}        playing | paused | stopped
#                           {state_icon}   ▶ | ⏸ | ■
#                           {artist}       track artist
#                           {title}        track title (falls back to filename)
#                           {album}        album name
#                           {tracknumber}  track number
#                           {date}         release date / year
#                           {duration}     track length, mm:ss
#                           {position}     elapsed time, mm:ss
#                           {remaining}    time left, mm:ss
#                           {file}         full file path
#                           {stream}       stream title (network streams)
#   -s, --state           Print only the player state (playing|paused|stopped)
#   -m, --max-length N    Truncate output to N characters, adding an ellipsis
#   --empty-stopped       Print nothing when playback is stopped
#   --json                Print Waybar-compatible JSON
#   -q, --quiet           No error messages; exit status still reflects state
#   -h, --help            Show this help and exit
#
# Exit codes:
#   0  cmus is running and a state was reported
#   1  cmus is not running (or cmus-remote failed)
#   2  invalid arguments
#   127 cmus-remote is not installed
#
# Examples:
#   cmus-now-playing
#   cmus-now-playing -f '{state_icon} {artist} - {title} [{position}/{duration}]'
#   cmus-now-playing -f '{album} ({date})'
#   cmus-now-playing --json --max-length 40
#
# tmux status line:
#   set -g status-right '#(cmus-now-playing -f "{state_icon} {artist} - {title}")'
#
# License: BSD 2-Clause

set -u

PROG="${0##*/}"
FORMAT='{artist} - {title}'
STATE_ONLY=0
QUIET=0
MAX_LENGTH=''
EMPTY_STOPPED=0
JSON=0

err() { [ "$QUIET" -eq 1 ] || printf '%s: %s\n' "$PROG" "$1" >&2; }
usage() { sed -n '2,/^# License/p' "$0" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
    case "$1" in
        -f|--format)
            [ $# -ge 2 ] || { err "option '$1' requires an argument"; exit 2; }
            FORMAT="$2"; shift 2 ;;
        -m|--max-length)
            [ $# -ge 2 ] || { err "option '$1' requires an argument"; exit 2; }
            case "$2" in
                ''|*[!0-9]*) err "max length must be a non-negative integer"; exit 2 ;;
            esac
            MAX_LENGTH="$2"; shift 2 ;;
        -s|--state) STATE_ONLY=1; shift ;;
        --empty-stopped) EMPTY_STOPPED=1; shift ;;
        --json) JSON=1; shift ;;
        -q|--quiet) QUIET=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) err "unknown option: $1 (try --help)"; exit 2 ;;
    esac
done

command -v cmus-remote >/dev/null 2>&1 || {
    err "cmus-remote is not installed"
    exit 127
}

OUT="$(cmus-remote -Q 2>/dev/null)" || {
    err "cmus is not running (cmus-remote -Q failed)"
    exit 1
}

STATE='unknown'
FILE=''
DUR=''
POS=''
ARTIST=''
TITLE=''
ALBUM=''
TRACKNUMBER=''
DATE=''
STREAM=''

while IFS= read -r line; do
    case "$line" in
        "tag "*)
            rest="${line#tag }"
            key="${rest%% *}"
            value="${rest#* }"
            case "$key" in
                artist) ARTIST="$value" ;;
                title) TITLE="$value" ;;
                album) ALBUM="$value" ;;
                tracknumber) TRACKNUMBER="$value" ;;
                date) DATE="$value" ;;
                stream) STREAM="$value" ;;
            esac ;;
        *" "*)
            key="${line%% *}"
            value="${line#* }"
            case "$key" in
                status) STATE="$value" ;;
                file) FILE="$value" ;;
                duration) DUR="$value" ;;
                position) POS="$value" ;;
                stream) [ -n "$STREAM" ] || STREAM="$value" ;;
            esac ;;
    esac
done <<EOF
$OUT
EOF

[ "$STATE_ONLY" -eq 1 ] && { printf '%s\n' "$STATE"; exit 0; }
[ "$EMPTY_STOPPED" -eq 1 ] && [ "$STATE" = stopped ] && exit 0

mmss() {
    case "$1" in
        ''|*[!0-9]*) printf -- '--:--' ;;
        *) printf '%d:%02d' "$(($1 / 60))" "$(($1 % 60))" ;;
    esac
}

if [ -z "$TITLE" ] && [ -n "$FILE" ]; then
    TITLE="${FILE##*/}"
    TITLE="${TITLE%.*}"
fi

case "$STATE" in
    playing) ICON='▶' ;;
    paused)  ICON='⏸' ;;
    *)       ICON='■' ;;
esac

REM=''
case "$DUR$POS" in
    *[!0-9]*|'') ;;
    *) REM=$(( DUR - POS )); [ "$REM" -lt 0 ] && REM=0 ;;
esac

DURATION="$(mmss "$DUR")"
POSITION="$(mmss "$POS")"
REMAINING="$(mmss "$REM")"

# Expand placeholders in one pass so placeholder-like tag text stays literal.
OUT_LINE=''
rest="$FORMAT"
while case "$rest" in *'{'*) true ;; *) false ;; esac; do
    prefix="${rest%%\{*}"
    token_and_suffix="${rest#*\{}"
    token="${token_and_suffix%%\}*}"
    if [ "$token_and_suffix" = "$token" ]; then
        OUT_LINE="$OUT_LINE$rest"
        rest=''
        break
    fi
    suffix="${token_and_suffix#*\}}"
    case "{$token}" in
        '{state}') value="$STATE" ;;
        '{state_icon}') value="$ICON" ;;
        '{artist}') value="$ARTIST" ;;
        '{title}') value="$TITLE" ;;
        '{album}') value="$ALBUM" ;;
        '{tracknumber}') value="$TRACKNUMBER" ;;
        '{date}') value="$DATE" ;;
        '{stream}') value="$STREAM" ;;
        '{file}') value="$FILE" ;;
        '{duration}') value="$DURATION" ;;
        '{position}') value="$POSITION" ;;
        '{remaining}') value="$REMAINING" ;;
        *) value="{$token}" ;;
    esac
    OUT_LINE="$OUT_LINE$prefix$value"
    rest="$suffix"
done
OUT_LINE="$OUT_LINE$rest"

if [ -n "$MAX_LENGTH" ] && [ "${#OUT_LINE}" -gt "$MAX_LENGTH" ]; then
    if [ "$MAX_LENGTH" -eq 0 ]; then
        OUT_LINE=''
    elif [ "$MAX_LENGTH" -eq 1 ]; then
        OUT_LINE='…'
    else
        OUT_LINE="${OUT_LINE:0:$((MAX_LENGTH - 1))}…"
    fi
fi

json_escape() {
    local text="$1" char code escaped='' i
    LC_ALL=C
    for ((i = 0; i < ${#text}; i++)); do
        char="${text:$i:1}"
        case "$char" in
            '"') escaped="$escaped\\\"" ;;
            '\') escaped="$escaped\\\\" ;;
            $'\b') escaped="$escaped\\b" ;;
            $'\f') escaped="$escaped\\f" ;;
            $'\n') escaped="$escaped\\n" ;;
            $'\r') escaped="$escaped\\r" ;;
            $'\t') escaped="$escaped\\t" ;;
            *)
                printf -v code '%d' "'$char"
                if [ "$code" -lt 32 ]; then
                    printf -v char '\\u%04x' "$code"
                    escaped="$escaped$char"
                else
                    escaped="$escaped$char"
                fi ;;
        esac
    done
    printf '%s' "$escaped"
}

if [ "$JSON" -eq 1 ]; then
    printf '{"text":"%s","alt":"%s","class":"%s"}\n' \
        "$(json_escape "$OUT_LINE")" "$(json_escape "$STATE")" "$(json_escape "$STATE")"
else
    printf '%s\n' "$OUT_LINE"
fi
